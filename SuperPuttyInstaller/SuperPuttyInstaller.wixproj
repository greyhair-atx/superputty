<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <InstallerScope Condition="'$(InstallerScope)' == ''">PerMachine</InstallerScope>
    <InstallerProductVersion Condition="'$(InstallerProductVersion)' == ''">1.7.4</InstallerProductVersion>
    <InstallerArtifactSuffix Condition="'$(InstallerArtifactSuffix)' == ''">test-x64</InstallerArtifactSuffix>
    <OutputName Condition="'$(InstallerScope)' == 'PerUser'">SuperPutty-$(InstallerProductVersion)-current-user-$(InstallerArtifactSuffix)</OutputName>
    <OutputName Condition="'$(InstallerScope)' == 'PerMachine'">SuperPutty-$(InstallerProductVersion)-all-users-$(InstallerArtifactSuffix)</OutputName>
    <DefineConstants>InstallerScope=$(InstallerScope);InstallerProductVersion=$(InstallerProductVersion);$(DefineConstants)</DefineConstants>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(InstallerScope)\</IntermediateOutputPath>
    <SuppressIces Condition="'$(InstallerScope)' == 'PerUser'">$(SuppressIces);ICE91</SuppressIces>
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperPutty\SuperPutty.csproj"
                      AdditionalProperties="Platform=x64" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
